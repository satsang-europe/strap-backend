{
  "kind": "collectionType",
  "collectionName": "upcoming_events",
  "info": {
    "singularName": "upcoming-event",
    "pluralName": "upcoming-events",
    "displayName": "UpcomingEvent"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "default": "satsang",
      "enum": [
        "satsang",
        "foodservice",
        "seminar"
      ]
    }
  }
}
