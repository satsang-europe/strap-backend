{
  "kind": "collectionType",
  "collectionName": "push_deliveries",
  "info": {
    "singularName": "push-delivery",
    "pluralName": "push-deliveries",
    "displayName": "Push Delivery",
    "description": "Private delivery state for mobile push notifications"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "deliveryKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "notificationDocumentId": {
      "type": "string",
      "required": true,
      "private": true
    },
    "title": {
      "type": "string",
      "required": true,
      "private": true
    },
    "pushMessage": {
      "type": "text",
      "required": true,
      "private": true
    },
    "activeAt": {
      "type": "datetime",
      "required": true,
      "private": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "processing",
        "sent",
        "partial",
        "failed",
        "expired"
      ],
      "required": true,
      "default": "pending",
      "private": true
    },
    "attempts": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0,
      "private": true
    },
    "nextAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "processingStartedAt": {
      "type": "datetime",
      "private": true
    },
    "sentAt": {
      "type": "datetime",
      "private": true
    },
    "ticketIds": {
      "type": "json",
      "private": true
    },
    "ticketErrors": {
      "type": "json",
      "private": true
    },
    "receiptStatus": {
      "type": "enumeration",
      "enum": [
        "not_required",
        "pending",
        "checking",
        "complete",
        "partial",
        "failed"
      ],
      "required": true,
      "default": "not_required",
      "private": true
    },
    "receiptAttempts": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0,
      "private": true
    },
    "nextReceiptCheckAt": {
      "type": "datetime",
      "private": true
    },
    "receiptProcessingStartedAt": {
      "type": "datetime",
      "private": true
    },
    "receiptCheckedAt": {
      "type": "datetime",
      "private": true
    },
    "receiptResults": {
      "type": "json",
      "private": true
    },
    "receiptSummary": {
      "type": "json",
      "private": true
    },
    "receiptLastError": {
      "type": "text",
      "private": true
    },
    "lastError": {
      "type": "text",
      "private": true
    }
  }
}
